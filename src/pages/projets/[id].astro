---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<MainLayout title={project.data.title}>
  <article class="project-detail">
    <p class="project-affiliation">{project.data.affiliation}</p>

    <h1>{project.data.title}</h1>

    <p class="summary">{project.data.summary}</p>

    {project.data.image && (
      <img src={project.data.image} alt={project.data.title} />
    )}

    <section>
      <h2>Contexte</h2>
      <p>{project.data.context}</p>
    </section>

    <section>
      <h2>Domaines</h2>
      <div class="badges">
        {project.data.domain.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section>
      <h2>Méthodes</h2>
      <div class="badges">
        {project.data.methods.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section>
      <h2>Outils utilisés</h2>
      <div class="badges">
        {project.data.tools.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section>
      <h2>Description du projet</h2>
      <Content />
    </section>

    <div class="project-links">
      {project.data.github && (
        <a href={project.data.github} target="_blank">Voir le code</a>
      )}

      {project.data.report && (
        <a href={project.data.report} target="_blank">Voir le rapport</a>
      )}
    </div>
  </article>
</MainLayout>
